# Flask Application Secret
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# Database URL
# Render PostgreSQL will automatically populate this in production.
# For local development, if left empty, SQLite (instance/indobid.db) is used automatically.
DATABASE_URL=

# Round duration in seconds (3600 = 1 hour)
ROUND_DURATION_SECONDS=3600

# Entry Fee & Razorpay Configuration
ENTRY_FEE_INR=49.0
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# Administrator Credentials
ADMIN_EMAIL=admin@indobid.lol
ADMIN_PASSWORD=IndoBidAdmin2026!

# Visual Participant Sample Size (5 to 15 entries)
GLASS_BOX_SAMPLE_SIZE=12
