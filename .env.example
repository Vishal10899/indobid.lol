# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/indobid_db?schema=public"

# Server Authentication & Security
AUTH_SECRET="replace_with_a_strong_random_jwt_secret"
ADMIN_EMAIL="vishalkumar75912@gmail.com"
ADMIN_SECRET_KEY="replace_with_a_secure_admin_secret_token"

# Google OAuth (Production social authentication)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Payment Gateway Configuration (Server-side only — NEVER prefix with NEXT_PUBLIC_)
# Razorpay Configuration:
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Cashfree Configuration (Alternative):
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_ENVIRONMENT="SANDBOX" # 'SANDBOX' or 'PRODUCTION'

# Transactional Email (Resend)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="IndoBid <noreply@indobid.lol>"

# IndoBid Daily — World Trend Engine
AUTO_DAILY_ENABLED="true"
AUTO_DAILY_DRY_RUN="false"
CRON_SECRET="replace_with_a_strong_cron_secret"
MAX_AUTO_POSTS_PER_DAY="5"
TREND_SCORE_THRESHOLD="50"
MIN_HOURS_BETWEEN_SAME_TOPIC="24"

# Application Base URL
NEXT_PUBLIC_APP_URL="https://indobid.lol"
